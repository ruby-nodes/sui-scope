# Probe agent environment variables
# Copy to .env for local development; never commit a filled-in .env.

# Geographic region label (required).
# On Fly.io this is set automatically from FLY_REGION — no need to set it manually.
# REGION=us-east-1

# Probe cycle interval in milliseconds (optional, default: 60000).
# PROBE_INTERVAL_MS=60000

# Override the path to providers.yaml (optional).
# PROVIDERS_YAML_PATH=/custom/path/providers.yaml

# API ingest endpoint (required).
INGEST_URL=http://suiscope-api.internal:3000/ingest

# Shared secret matching the API server's INGEST_SECRET (required).
INGEST_SECRET=
