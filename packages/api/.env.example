# API server environment variables
# Copy to .env for local development; never commit a filled-in .env.

# ClickHouse connection (required).
CLICKHOUSE_URL=http://suiscope-clickhouse.internal:8123
CLICKHOUSE_DATABASE=suiscope
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# Shared secret for probe ingest authentication (required).
# Probe agents must send this as: Authorization: Bearer <INGEST_SECRET>
INGEST_SECRET=

# HTTP port (optional, default: 3000).
# PORT=3000
